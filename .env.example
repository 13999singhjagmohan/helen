# Server
APP_NAME=Helen
PORT=3000

# LLM backend: "mock" (offline demo) or "openai-compatible"
LLM_PROVIDER=mock

# For openai-compatible: any endpoint that speaks the /v1/chat/completions format
# (self-hosted model servers, local runtimes, or a hosted provider whose terms permit your use).
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=llama3.1

# Set to true ONLY if your provider's usage policy permits sexually explicit content.
# When false, the "explicit" content level is capped at "sensual".
PROVIDER_ALLOWS_EXPLICIT=false

# Optional in-chat photos: "none" or "openai-compatible" (/v1/images/generations).
# Use a backend you control or one whose terms permit your content.
IMAGE_PROVIDER=none
IMAGE_BASE_URL=http://localhost:7860/v1
IMAGE_API_KEY=
IMAGE_MODEL=sdxl
